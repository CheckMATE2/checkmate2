[Parameters]
Name: 13TeV-test-mg5
Analyses: atlas13TeV
SLHAFile: @cardsdir@bin/example_run_cards/auxiliary/testspectrum.slha

#[13TeV-test]
#Pythia8Process: p p > go go
#MaxEvents: 10000

[13TeV-mg5]
MGCommand: import model MSSM_SLHA2;
           define  sq = ul ur t1 t2 b1 b2 ul~ ur~ t1~ t2~ b1~ b2~;
           generate p p > sq sq;
KFactor: 1.0
MaxEvents: 10000
