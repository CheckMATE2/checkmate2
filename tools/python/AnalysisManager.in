#!/usr/bin/env python3

import os
import sys

sys.path.append(os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tools", "python"))

import analysismanager_core
from advprint import AdvPrint
from info import Info

config_paths = dict()
config_paths['mg5_source_path']='@MADGRAPHDIR@'
config_paths['pythia8_lib_path']='@PYTHIALIBDIR@'
config_paths['install_dir']='@prefix@' 
config_paths['data_dir']='@datadir@'
config_paths['source']='@sourcedir@'
if os.getenv("CHECKMATE_RESULTS") is not None:
    config_paths['results']=os.getenv("CHECKMATE_RESULTS")
else:
    config_paths['results']='@RESULTSDIR@'
config_paths['remote']="@user_defined_prefix@"

global Info, AdvPrint
Info.init(config_paths)

def main():
    analysismanager_core.main()

if __name__ == "__main__":
    main()
